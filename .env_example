DEBUG=on
SECRET_KEY=your-secret-key
ALLOWED_HOSTS=*
ENVIRONMENT=local

ACCESS_TOKEN_LIFETIME=2592000
REFRESH_TOKEN_LIFETIME=1

# Database
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSL_MODE=require

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_PORT=587

# Firebase (base64-encoded service account JSON)
FIREBASE_CREDENTIALS=your-base64-encoded-firebase-credentials

# Sentry
SENTRY_DNS=your-sentry-dsn

# SMS (Smart Egypt)
SMS_SMART_EGYPT_SENDER_NAME=Petromaster
SMS_SMART_EGYPT_USERNAME=your-sms-username
SMS_SMART_EGYPT_PASSWORD=your-sms-password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Celery
# true: queue background tasks (push, SMS, email) for a Celery worker, which must
# be running (deploy/celery-worker.service). false: run them inline in the request.
USE_CELERY=false
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Google Drive storage for uploaded files (off: files stay in media/).
# GOOGLE_DRIVE_CREDENTIALS is the base64 service-account JSON. The folder must be
# in a Shared Drive the service account belongs to (service accounts have no quota).
# Copy existing files over with: python manage.py upload_media_to_drive
GOOGLE_DRIVE_STORAGE_ENABLED=false
GOOGLE_DRIVE_CREDENTIALS=base64-encoded-service-account-json
GOOGLE_DRIVE_FOLDER_ID=your-shared-drive-folder-id
# Share each upload as "anyone with the link" so its URL opens without login.
GOOGLE_DRIVE_PUBLIC=true
# Optional; {file_id} is replaced. Default: https://drive.google.com/uc?export=download&id={file_id}
GOOGLE_DRIVE_URL_TEMPLATE=

# OpenAI
OPENAI_API_KEY=your-openai-api-key

SERVICE_NAME=petromaster-staging
