DEBUG=on
SECRET_KEY=your-secret-key
ALLOWED_HOSTS=*
ENVIRONMENT=local

ACCESS_TOKEN_LIFETIME=2592000
REFRESH_TOKEN_LIFETIME=1

# Database
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSL_MODE=require

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_PORT=587

# Firebase (base64-encoded service account JSON)
FIREBASE_CREDENTIALS=your-base64-encoded-firebase-credentials

# Sentry
SENTRY_DNS=your-sentry-dsn

# SMS (Smart Egypt)
SMS_SMART_EGYPT_SENDER_NAME=Petromaster
SMS_SMART_EGYPT_USERNAME=your-sms-username
SMS_SMART_EGYPT_PASSWORD=your-sms-password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Object storage (DigitalOcean Spaces / S3)
DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_ENDPOINT_URL=https://fra1.digitaloceanspaces.com
AWS_S3_REGION_NAME=fra1
AWS_S3_FILE_OVERWRITE=False
AWS_DEFAULT_ACL=public-read

# OpenAI
OPENAI_API_KEY=your-openai-api-key
